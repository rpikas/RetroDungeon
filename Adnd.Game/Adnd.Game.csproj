<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Input\" />
    <Folder Include="Entities\" />
    <Folder Include="UI\" />
    <Folder Include="World\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adnd.Core\Adnd.Core.csproj" />
    <ProjectReference Include="..\Adnd.Data\Adnd.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Monsters\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Reference data. The repositories load these by relative path at runtime ("Data/Items",
    "Data/Spells", and so on), but nothing copied them to the output directory, so a freshly
    cloned and built game had no Data folder at all and had to have one assembled by hand.

    Save state is deliberately absent from this list. "Data/Characters", "Data/Party" and
    "Data/Config" are written by the game, exist only in the output directory, and are not in
    source control. A copy rule covering them would overwrite a player's roster on every build.

    PreserveNewest also means a shop that has sold stock down keeps its counts across rebuilds,
    since the output file is then newer than the source.
  -->
  <ItemGroup>
    <Content Include="..\Adnd.Data\Items\*.json" Link="Data\Items\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Adnd.Data\Monsters\*.json" Link="Data\Monsters\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Adnd.Data\Spells\*.json" Link="Data\Spells\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Adnd.Data\CharaterSavingThrows.json" Link="Data\CharaterSavingThrows.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Adnd.Data\Treasure\*.json" Link="Data\Treasure\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Adnd.Data\Encounters\**\*.json" Link="Data\Encounters\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\..\..\..\dev\Images\Monsters\Level6\basilisk.jpg" Link="Assets\Monsters\Level6\basilisk.jpg" />
    <Content Include="..\..\..\..\..\..\dev\Images\Monsters\Level6\giantant(warrior).png" Link="Assets\Monsters\Level6\giantant%28warrior%29.png" />
    <Content Include="..\..\..\..\..\..\dev\Images\Monsters\Level6\minotaur.jpg" Link="Assets\Monsters\Level6\minotaur.jpg" />
    <Content Include="..\..\..\..\..\..\dev\Images\Monsters\Level6\wraith.png" Link="Assets\Monsters\Level6\wraith.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\..\..\..\dev\Images\Monsters\Level6\giant crocodile.webp" Link="Assets\Monsters\Level6\giant crocodile.webp" />
  </ItemGroup>

</Project>
